# Required
GITHUB_TOKEN=ghp_your_github_pat
API_KEY=replace_with_a_random_shared_secret

# Network / servers
HTTP_PORT=3100

# Claim lifecycle
CLAIM_TIMEOUT_MINUTES=120
STALE_AUTO_RELEASE_MINUTES=0
AUTO_CLOSE_GITHUB_ISSUE=false

# Persistence / sync
STATE_FILE_PATH=./issuecommand-state.json
SYNC_INTERVAL_MINUTES=15

# Repo scope (comma-separated owner/repo list; empty means all accessible repos)
ALLOWED_REPOS=

# Optional logging target
LOG_FILE=

{
  "name": "issuecommand",
  "version": "0.1.0",
  "description": "IssueCommand: centralized issue claim system for multi-agent GitHub workflows",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t issuecommand:latest .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:restart": "pm2 restart issuecommand --update-env",
    "pm2:stop": "pm2 stop issuecommand"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "bun-types": "^1.3.8",
    "typescript": "^5.9.3"
  }
}
